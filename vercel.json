{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.4.x",
  "framework": null,
  "installCommand": "bun install --frozen-lockfile --linker hoisted",
  "buildCommand": "bun run --cwd server db:generate && bun run --cwd server db:deploy && bun run --cwd client build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{server/knowledge-base.md,server/generated/**,server/tsconfig.json,core/**,node_modules/@better-auth/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/cron/poll-inbox", "schedule": "0 8 * * *" }]
}
