# Template for client/.env. VITE_* values are baked in at build time (set them in the Vercel project before deploying).

# Optional: report browser errors to Sentry (off while empty). The DSN is public by design, but use your own project's.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Optional: WhatsApp number for the chat button on the home page, international format, digits only (e.g. 919876543210).
# Left empty, the button opens WhatsApp with the message prefilled and the visitor picks the contact.
VITE_WHATSAPP_NUMBER=
