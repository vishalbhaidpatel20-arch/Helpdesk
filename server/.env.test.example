# Copy to .env.test. Used only by the Playwright e2e run; the database name MUST end in _test.
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/helpdesk_test?schema=public"
BETTER_AUTH_SECRET=<any random string, e.g. openssl rand -base64 32>
BETTER_AUTH_URL=http://localhost:3001
CLIENT_URL=http://localhost:5174
PORT=3001
SEED_ADMIN_EMAIL=admin@test.example
SEED_ADMIN_PASSWORD=test-admin-password-123
SEED_AGENT_EMAIL=agent@test.example
SEED_AGENT_PASSWORD=test-agent-password-123
# Shared secret for POST /api/webhooks/inbound-email (sent in the x-webhook-secret header)
INBOUND_EMAIL_SECRET=test-inbound-secret-123

# Used by the reply "Polish" button (Vercel AI SDK, Gemini; free key at aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=<your Google AI Studio API key>

# Optional: receive support email over SMTP (off unless SMTP_DOMAIN is set)
# SMTP_DOMAIN=helpdesk.example.com
# SMTP_PORT=2525
# Gmail app password, used by IMAP polling unless IMAP_PASSWORD is set (leave unset in tests)
# SMTP_PASSWORD=

# Optional: receive support email by polling a mailbox over IMAP (off unless IMAP_USER is set)
# IMAP_USER=you@gmail.com
# IMAP_PASSWORD=
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_POLL_SECONDS=60
# IMAP_MAX_AGE_DAYS=3

# Optional: email agent replies to customers (on when MAIL_USER or IMAP_USER is set; uses SMTP_PASSWORD unless MAIL_PASSWORD is set)
# MAIL_USER=you@gmail.com
# MAIL_PASSWORD=
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_FROM=you@gmail.com
