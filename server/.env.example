# Template for the server's environment (local server/.env, or the Environment Variables settings of the Vercel project).
# Real values never go in git.

# --- Required ---
DATABASE_URL=postgresql://user:password@localhost:5432/helpdesk
# Any long random string: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The public origin of the app. In production the server serves the client too, so both are the same https URL.
BETTER_AUTH_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173
# Shared secret for POST /api/webhooks/inbound-email (header x-webhook-secret)
INBOUND_EMAIL_SECRET=

# --- First admin (used once by `bun run --cwd server db:seed`) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- AI (classification, auto-resolve, polish, summaries); without it tickets open straight for the agents ---
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Receive email by polling a mailbox over IMAP (off while IMAP_USER is empty) ---
IMAP_USER=
# Gmail app password; also used for sending replies unless MAIL_PASSWORD is set
SMTP_PASSWORD=
# IMAP_PASSWORD=  IMAP_HOST=imap.gmail.com  IMAP_PORT=993  IMAP_POLL_SECONDS=60  IMAP_MAX_AGE_DAYS=3

# --- Send replies (on when MAIL_USER or IMAP_USER is set) ---
# MAIL_USER=  MAIL_PASSWORD=  MAIL_HOST=smtp.gmail.com  MAIL_PORT=465  MAIL_FROM=

# --- Inbound SMTP server (leave unset on Vercel: it cannot receive raw SMTP) ---
# SMTP_DOMAIN=  SMTP_PORT=2525  SMTP_HOST=0.0.0.0  SMTP_MAX_MESSAGE_BYTES=10485760

# --- Local server only (ignored on Vercel) ---
# PORT=3000

# --- Vercel Cron: secret for GET /api/cron/poll-inbox (Vercel sends it as a Bearer token) ---
CRON_SECRET=

# --- Error reporting (off while empty) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
